### Logowanie - ADMIN (zapisuje adminToken)
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "admin-password-123"
}

> {%
  client.global.set("adminToken", response.body.accessToken);
%}

### Logowanie - Jakub Sosnowski, USER (zapisuje jakubToken)
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "jakub.sosnowski@example.com",
  "password": "jakub-password-123"
}

> {%
  var token = response.body.accessToken;
  var parts = token.split(".");
  var changed = parts[2].charAt(0) === "A" ? "B" : "A";
  client.global.set("jakubToken", token);
  client.global.set("jakubSignature", parts[2]);
  client.global.set("badSignatureToken", parts[0] + "." + parts[1] + "." + changed + parts[2].slice(1));
%}

### Logowanie - Anna Nowak, USER (zapisuje annaToken)
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "anna.nowak@example.com",
  "password": "anna-password-123"
}

> {%
  client.global.set("annaToken", response.body.accessToken);
%}

